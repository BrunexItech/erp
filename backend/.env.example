DATABASE_URL=postgresql+asyncpg://erp:erp@localhost:5435/erp
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Public address of the web app (used in email links)
APP_URL=http://localhost:3000

# Outgoing email — leave SMTP_HOST empty to save messages to media/outbox instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=no-reply@yourdomain.co.ke
MAIL_FROM_NAME=Business Suite

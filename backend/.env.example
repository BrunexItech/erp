DATABASE_URL=postgresql+asyncpg://erp:erp@localhost:5435/erp
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Public address of the web app (used in email links)
APP_URL=http://localhost:3000

# Outgoing email — leave SMTP_HOST empty to save messages to media/outbox instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=no-reply@yourdomain.co.ke
MAIL_FROM_NAME=Business Suite

# Public address of this API. Safaricom posts M-Pesa results here, so in
# production it must be an https address reachable from the internet.
API_PUBLIC_URL=http://localhost:8000

# Key for encrypting stored M-Pesa API keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set it once and keep it: changing it makes saved keys unreadable.
ENCRYPTION_KEY=

# Every query runs as this restricted database role so one business can never
# read another's rows (created by the migrations). Leave as is.
DB_APP_ROLE=erp_app

# The calendar businesses trade in (sets the date on a sale made near midnight)
BUSINESS_TIMEZONE=Africa/Nairobi

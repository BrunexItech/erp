# Copy to .env on the server and fill in. Never commit the real file.

# Makes plain `docker compose ...` commands (and the backup script) use the
# production stack.
COMPOSE_FILE=docker-compose.prod.yml

DOMAIN=erp.oqtekal.com
APP_PORT=8090

# Generate each of these once and keep them:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
#   openssl rand -hex 48
JWT_SECRET=
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# Changing this later makes saved M-Pesa keys unreadable.
ENCRYPTION_KEY=

# Outgoing email. Leave SMTP_HOST empty and emails are saved on the server
# instead of sent (the app says so on screen).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@oqtekal.com
MAIL_FROM_NAME=Business Suite
